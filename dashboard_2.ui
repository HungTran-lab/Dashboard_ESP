    border-radius: 4px;
}

QSlider::sub-page:horizontal {
    background: red;         /* phần đã kéo (trái) */
    border-radius: 4px;
}

QSlider::add-page:horizontal {
    background: #222;        /* phần chưa kéo (phải) */
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: white;       /* núm trượt */
    border: 1px solid black;
    width: 14px;
    margin: -4px 0;          /* canh giữa rãnh */
    border-radius: 7px;
}
</string>
